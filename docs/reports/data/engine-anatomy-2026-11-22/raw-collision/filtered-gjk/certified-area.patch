+
+// Границы прямой ошибки минора в м⁴ для binary64, round-to-nearest, без
+// переполнения/потери относительной точности при underflow. Для одного члена
+// разложения через исходные координаты до 10 округлений. 8 epsilon = 16u
+// покрывает gamma_10 и округление самой суммы абсолютных произведений.
+Vector3 magnitudes(Vector3 x) { return {abs(x.x), abs(x.y), abs(x.z)}; }
+
+Vector3 crossPermanent(Vector3 x, Vector3 y) {
+    x = magnitudes(x);
+    y = magnitudes(y);
+    return {x.y*y.z + x.z*y.y, x.z*y.x + x.x*y.z, x.x*y.y + x.y*y.x};
+}
+
+// Для вершины с противолежащим ребром pq исходный минор — определитель
+// скалярных произведений ab,ac с p,q (до знака). У ориентированной площади
+// того же минора две пары сомножителей векторного произведения.
+Real filteredMinor(Real gram, Vector3 p, Vector3 q, Vector3 ab, Vector3 ac, Vector3 bc,
+                   Vector3 first, Vector3 second) {
+    const Vector3 lab = magnitudes(ab), lac = magnitudes(ac);
+    const Vector3 lp = magnitudes(p), lq = magnitudes(q);
+    const Real bound = (8 * kEpsilon) * (lab.dot(lp) * lac.dot(lq) + lab.dot(lq) * lac.dot(lp));
+    if (!std::isnormal(bound) || abs(gram) > bound) return gram;
+
+    const Vector3 shortEdge = bc.lengthSquare() < ac.lengthSquare() ? bc : ac;
+    const Real area = first.cross(second).dot(ab.cross(shortEdge));
+    const Real areaBound = (8 * kEpsilon) * crossPermanent(first, second).dot(crossPermanent(ab, shortEdge));
+    const bool useArea = std::isnormal(areaBound) && abs(area) > areaBound;
+#ifdef KP_GJK_FILTER_TRACE
+    std::fprintf(stderr, "minor,%s,%.17g,%.17g,%.17g,%.17g\n", useArea ? "area" : "unresolved",
+                 double(gram), double(bound), double(area), double(areaBound));
+#endif
+    return useArea ? area : gram;
 }
 
