 void DirectJoints::push(size_t row, StepArray<SolverBody>& states, Real impulse) const {
+    counter.calls.fetch_add(1,std::memory_order_relaxed);
+    if (impulse==0) counter.zeros.fetch_add(1,std::memory_order_relaxed);
