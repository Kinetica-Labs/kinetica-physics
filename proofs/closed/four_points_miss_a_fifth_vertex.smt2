; Дыра А. Четырёх точек недостаточно для площадки с пятью вершинами. Площадка — пятиугольник;
; скорость сближения линейна по положению: f = α + β·x + γ·y. В четырёх оставленных вершинах тела
; не сближаются, а в пятой, отброшенной, сближаются. Задача выполнима (sat): сокращение площадки
; до четырёх точек не гарантирует отсутствия проникновения.
(declare-const alpha Real) (declare-const beta Real) (declare-const gamma Real)
(define-fun f ((x Real) (y Real)) Real (+ alpha (* beta x) (* gamma y)))
(assert (>= (f 0.0 0.0) 0.0))
(assert (>= (f 2.0 0.0) 0.0))
(assert (>= (f 3.0 2.0) 0.0))
(assert (>= (f (- 1.0) 2.0) 0.0))
(assert (< (f 1.0 3.0) 0.0))
(check-sat)
