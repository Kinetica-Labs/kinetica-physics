; Дыра Б. Четырёх точек окружности недостаточно для круга торца. В четырёх точках через четверть
; оборота тела не сближаются, а в точке окружности между ними сближаются. Задача выполнима (sat):
; у круга бесконечно много «вершин», и конечный набор точек не гарантирует отсутствия
; проникновения. Точное условие для круга — не точки, а конус: f(центр) >= R·|grad f|.
(declare-const alpha Real) (declare-const beta Real) (declare-const gamma Real) (declare-const s Real)
(define-fun f ((x Real) (y Real)) Real (+ alpha (* beta x) (* gamma y)))
(assert (and (> s 0.0) (= (* 2.0 s s) 1.0)))
(assert (>= (f 1.0 0.0) 0.0))
(assert (>= (f 0.0 1.0) 0.0))
(assert (>= (f (- 1.0) 0.0) 0.0))
(assert (>= (f 0.0 (- 1.0)) 0.0))
(assert (< (f s s) 0.0))
(check-sat)
