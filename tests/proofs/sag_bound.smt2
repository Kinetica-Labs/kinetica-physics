; Лемма 11. Прогиб под хордой. Функция f на участке [0, Δ] со второй производной не больше M
; опускается ниже меньшего из значений на концах не больше чем на M·Δ²/8. Функция
; g(s) = f(s) − M·s·(Δ − s)/2 имеет вторую производную f'' − M <= 0, то есть вогнута, а вогнутая
; функция в точке s = (1 − λ)·0 + λ·Δ не меньше смеси значений на концах: g(s) >= (1 − λ)·g(0) + λ·g(Δ).
; Это неравенство — посылка (вогнутость из знака второй производной — теорема анализа, Z3 её не
; проверяет). Вывод: f(s) >= min(f(0), f(Δ)) − M·Δ²/8. На нём стоит заверение участка в поиске
; начала перекрытия (overlapStart, engine/world/World.cpp). Ответ unsat.
(declare-const f0 Real) (declare-const f1 Real) (declare-const fs Real)
(declare-const M Real) (declare-const D Real) (declare-const l Real)
(define-fun s () Real (* l D))
(assert (and (>= M 0.0) (> D 0.0) (>= l 0.0) (<= l 1.0)))
(assert (>= (+ fs (* M 0.5 s (- D s))) (+ (* (- 1.0 l) f0) (* l f1))))
(assert (< fs (- (ite (<= f0 f1) f0 f1) (* M D D 0.125))))
(check-sat)
