; Лемма 20. Шаг спуска по активному набору (ContactSolver::solveActiveSet, надёжный путь) не
; увеличивает функцию ½ λᵀ A λ + bᵀ λ. Из допустимой точки λ шаг идёт к точке z — минимуму функции на
; нынешнем наборе — и останавливается на доле α от пути, 0 <= α <= 1. На прямой через λ и z
; выпуклая квадратичная функция — выпуклая парабола f(t) = a t² / 2 + c t, a > 0, с минимумом в z,
; поэтому достаточно одной переменной: f(λ + α (z − λ)) <= f(λ). Значит, наборы не повторяются, и
; перебор конечен. Ответ unsat.
(declare-const a Real) (declare-const c Real) (declare-const l Real) (declare-const z Real) (declare-const s Real)
(define-fun f ((t Real)) Real (+ (/ (* a t t) 2.0) (* c t)))
(assert (and (> a 0.0) (= (* a z) (- c)) (>= s 0.0) (<= s 1.0)))
(assert (not (<= (f (+ l (* s (- z l)))) (f l))))
(check-sat)
